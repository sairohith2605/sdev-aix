# Configuration template for local/self-hosted installs.
# Copy to a private .env file before enabling the corresponding integration.
# Do not place credentials in variables beginning with VITE_: they are public in the browser bundle.

# Frontend: Vite dev uses mock data by default; set to false to call a real API.
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=true

# Backend application (required when the API is implemented)
APP_ORIGIN=http://localhost:5173
DATABASE_URL=
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Future Docker Compose database container (required for bundled PostgreSQL)
POSTGRES_DB=sdev_aix
POSTGRES_USER=sdev_aix
POSTGRES_PASSWORD=

# Azure DevOps / Microsoft Entra (required when the connection is implemented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_DEVOPS_ORGANIZATION=

# GitHub Copilot device sign-in (required when the provider is implemented)
GITHUB_CLIENT_ID=

# Optional API-key providers (set only for enabled providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional remote Azure DevOps MCP enrichment (future integration)
AZURE_DEVOPS_MCP_ENABLED=false
