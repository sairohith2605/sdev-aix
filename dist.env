# Configuration template for local/self-hosted installs.
# Copy to a private .env file before enabling the corresponding integration.
# Do not place credentials in variables beginning with VITE_: they are public in the browser bundle.

# Frontend: Vite dev uses mock data by default; set to false to call a real API.
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=true

# Backend application
APP_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/sdev-aix.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
ADO_API_VERSION=7.1
ADO_REQUEST_TIMEOUT_SECONDS=15

# Backend-only fallback for the Copilot analysis probe. Normal application use
# saves the PAT through Connections, encrypted in backend SQLite. Never add this
# to a frontend environment file.
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=auto
COPILOT_TIMEOUT_SECONDS=90
# Local: ./data/copilot; Compose sets COPILOT_DATA_PATH=/data/copilot.
# COPILOT_DATA_PATH=./data/copilot

# Local repository indexing is opt-in: a directory containing the target repositories.
# Compose mounts it read-only at /workspace; enter /workspace/<repository> in Connections.
# REPOSITORY_WORKSPACE=/absolute/path/to/projects
# For a locally running backend, configure an explicit allowed directory:
# REPOSITORY_ALLOWED_ROOTS=/absolute/path/to/projects
REPOSITORY_MAX_FILE_BYTES=512000
REPOSITORY_CONTEXT_CHARS=40000

# Optional published port for the local Docker Compose frontend.
FRONTEND_PORT=8080

# Azure DevOps connection (configured in the app; do not put a PAT in this file).
# One Org:Project:Team is stored encrypted in the backend SQLite database.

# Optional API-key providers (set only for enabled providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional remote Azure DevOps MCP enrichment (future integration)
AZURE_DEVOPS_MCP_ENABLED=false
